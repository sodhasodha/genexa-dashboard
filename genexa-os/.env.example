# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:push` to apply migrations
SUPABASE_DB_URL=

# Public URL of this app (links in Slack messages, magic-link redirect)
APP_URL=http://localhost:3000

# Cortana: ads, attribution, Whop payments
CORTANA_API_KEY=
CORTANA_BASE_URL=https://app.usecortana.ai/api/v1
GENEXA_WHOP_CORTANA_BUSINESS_ID=893e8bff-93f9-41b2-b85b-0e98b5bafb7d

# GHL: {"<clinic name>": {"location_id": "...", "api_key": "..."}}
GHL_API_KEYS_JSON=

MERCURY_API_KEY=
FATHOM_API_KEY=
FATHOM_WEBHOOK_SECRET=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_EOD_REPORTS=
SLACK_CHANNEL_MEDIA_BUYING=
SLACK_CHANNEL_TEAM=

# Shared secret for inbound webhooks (outcome, onboarding, GHL)
WEBHOOK_SECRET=
# Bearer token for /api/mcp
MCP_BEARER_TOKEN=
# Bearer token pg_cron sends to /api/jobs/*
CRON_SECRET=

# One-off import from monday.com (read-only). Not needed in production.
MONDAY_API_TOKEN=

# Where pg_cron sends job calls (`npm run setup:cron`). Usually the same as APP_URL in production.
CRON_TARGET_URL=

# Slack workspaces. Team = alerts, reminders, buttons. Client = listen-only second install of the same app.
SLACK_TEAM_ID=
SLACK_CLIENT_TEAM_ID=
SLACK_CLIENT_BOT_TOKEN=
SLACK_CLIENT_SIGNING_SECRET=

# Mercury only accepts calls from an allow-listed IP: requests go through this static-IP proxy
FIXIE_URL=
# Whop direct API
WHOP_API_KEY=
